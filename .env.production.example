# Copy this file to .env.production, replace every CHANGE_ME value, and keep
# the copied file out of version control.
POSTGRES_DB=fejd
POSTGRES_USER=fejd_app
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgres://fejd_app:CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD@postgres:5432/fejd?sslmode=disable

KEYCLOAK_ADMIN_USERNAME=CHANGE_ME_KEYCLOAK_ADMIN
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_KEYCLOAK_PASSWORD
FEJD_ADMIN_CLIENT_SECRET=CHANGE_ME_LONG_RANDOM_ADMIN_CLIENT_SECRET
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_LONG_RANDOM_BACKEND_CLIENT_SECRET

# Public Keycloak issuer (must match KC_HOSTNAME). Tokens are minted with
# iss=<this>/realms/fejd, so this must be the public hostname, not the internal
# docker service URL.
KEYCLOAK_ISSUER_URL=https://auth.fejd.fyi/realms/fejd

SEAWEEDFS_S3_ACCESS_KEY=fejd_storage
SEAWEEDFS_S3_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SEAWEEDFS_SECRET_KEY
S3_REGION=us-east-1
S3_BUCKET=fejd-images

SMTP_FROM=no-reply@fejd.fyi
SUPERADMIN_NOTIFY_EMAIL=admin@fejd.fyi
RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY

# Optional build/runtime settings.
VITE_GOOGLE_MAPS_API_KEY=
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
KEYCLOAK_AUDIENCES=salon-mobile,fejd-frontend
CORS_ALLOWED_SUFFIX=fejd.fyi
FEJD_DOMAIN=fejd.fyi
INVITE_BASE_URL=https://fejd.fyi
INVITE_REDIRECT_URI=https://fejd.fyi